def get_matched_block(lines, line_number, pattern):
    block_lines = []
    for i in range(line_number - 1, min(line_number + 4, len(lines))):
        block_lines.append(lines[i].rstrip())
        if i + 1 < len(lines):
            next_line = lines[i + 1].strip()
            if not next_line or (not next_line.startswith(('.', '+', ')', ',', 'WHERE', 'FROM', 'AND', 'OR'))):
                break

    return "\n".join(block_lines)


def scan_file(config: PipelineConfig):
    findings = []

    with open(config.file_path, "r") as file:
        lines = file.readlines()

        for line_number, line in enumerate(lines, start=1):
            stripped = line.strip()

            if stripped.startswith("#") or stripped.startswith("//"):
                continue

            # Tier 1: Hardcoded secrets — HIGH
            if config.high_confidence.search(line):
                findings.append({
                    "file_path": config.file_path,
                    "line_number": line_number,
                    "type": "Hardcoded Secret",
                    "confidence": "HIGH",
                    "code": stripped
                })
                continue

            # Tier 2: Ambiguous secrets — LOW
            match = config.ambiguous_keys.search(line)
            if match:
                value = match.group(2)
                if not config.safe_values.match(value):
                    findings.append({
                        "file_path": config.file_path,
                        "line_number": line_number,
                        "type": "Possible Hardcoded Secret",
                        "confidence": "LOW",
                        "code": stripped
                    })
                continue

            line_window = "".join(lines[line_number - 1: line_number + 4])

            # Tier 3: SQL Injection — HIGH
            if config.sql_injection.search(line_window):
                findings.append({
                    "file_path": config.file_path,
                    "line_number": line_number,
                    "type": "SQL Injection",
                    "confidence": "HIGH",
                    "code": get_matched_block(lines, line_number, config.sql_injection)
                })
                continue

            # Tier 4: Insecure Direct Object Reference — HIGH
            if config.direct_reference.search(line_window):
                findings.append({
                    "file_path": config.file_path,
                    "line_number": line_number,
                    "type": "Insecure Direct Object Reference",
                    "confidence": "HIGH",
                    "code": get_matched_block(lines, line_number, config.direct_reference)
                })
                continue

            # Tier 5: Command Injection — HIGH
            if config.command_injection.search(line_window):
                findings.append({
                    "file_path": config.file_path,
                    "line_number": line_number,
                    "type": "Command Injection",
                    "confidence": "HIGH",
                    "code": get_matched_block(lines, line_number, config.command_injection)
                })
                continue

            # Tier 6: XXE Injection — HIGH
            if config.xxe_injection.search(line_window):
                findings.append({
                    "file_path": config.file_path,
                    "line_number": line_number,
                    "type": "XXE Injection",
                    "confidence": "HIGH",
                    "code": get_matched_block(lines, line_number, config.xxe_injection)
                })

    return findings


def extract_clean_response(full_response: str, vulnerable_code: str) -> str:
    cleaned = re.sub(r"```(?:\w+)?\n?|```", "", full_response).strip()

    expected_lines = len(vulnerable_code.strip().splitlines())

    output_lines = cleaned.splitlines()

    # XXE fixes need at least 2 lines (parser setup + parse call)
    if "XMLParser" in cleaned or "defusedxml" in cleaned:
        expected_lines = max(expected_lines, 2)

    cleaned = "\n".join(output_lines[:expected_lines]).strip()
    return cleaned


